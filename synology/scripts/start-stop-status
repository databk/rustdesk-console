#!/bin/sh

PKG_NAME=rustdesk-console
PKG_DIR="${SYNOPKG_PKGDEST:-/var/packages/${PKG_NAME}/target}"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/${PKG_NAME}/var}"
PID_FILE="$VAR_DIR/console.pid"
LOG_FILE="$VAR_DIR/console.log"

if [ -f "$VAR_DIR/.env" ]; then
    set -a
    . "$VAR_DIR/.env"
    set +a
fi

is_running() {
    [ -f "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

http_ready() {
    command -v curl >/dev/null 2>&1 || return 0
    curl -sf "http://127.0.0.1:${PORT:-3000}/api/login-options" >/dev/null 2>&1
}

case "${1:-}" in
    start)
        if is_running; then
            exit 0
        fi
        mkdir -p "$VAR_DIR"
        nohup "$PKG_DIR/run.sh" >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        i=0
        while [ "$i" -lt 30 ]; do
            if is_running && http_ready; then
                exit 0
            fi
            i=$((i + 1))
            sleep 1
        done
        is_running && exit 0
        echo "[start-stop-status] service failed to start, see $LOG_FILE" >&2
        exit 1
        ;;
    stop)
        if is_running; then
            pid=$(cat "$PID_FILE")
            kill "$pid" 2>/dev/null || true
            i=0
            while [ "$i" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
                i=$((i + 1))
                sleep 1
            done
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
        exit 0
        ;;
    status)
        is_running && exit 0
        exit 3
        ;;
esac

echo "usage: $0 {start|stop|status}" >&2
exit 1
