#!/bin/sh
# 配置回调 - 保存服务器公网地址并在服务运行时重启
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
DNAME="RustDesk Server"
RELAY_ADDRESS="${wizard_relay_address:-}"

mkdir -p "${TRIM_PKGETC}"
printf 'RELAY_ADDRESS=%s\n' "$RELAY_ADDRESS" > "${TRIM_PKGETC}/settings.conf"
chmod 644 "${TRIM_PKGETC}/settings.conf"

if "${SCRIPT_DIR}/main" status >/dev/null 2>&1; then
    echo "${DNAME}: 配置已保存，重启服务..."
    "${SCRIPT_DIR}/main" restart
else
    echo "${DNAME}: 配置已保存"
fi
