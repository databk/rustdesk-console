#!/bin/sh
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "${SCRIPT_DIR}/common"

if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    exec >>"$TRIM_TEMP_LOGFILE" 2>&1
fi

. "${SCRIPT_DIR}/service-setup"

# TCP 端口是否已监听（用于健康检查）
port_open() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -tln 2>/dev/null | awk '{print $4}' | grep -q ":${port}$"
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tln 2>/dev/null | awk '{print $4}' | grep -q ":${port}$"
    else
        return 0
    fi
}

# 等待进程监听指定端口
wait_for_port() {
    local name="$1"
    local port="$2"
    local attempts=30
    local i=0
    while [ "$i" -lt "$attempts" ]; do
        if ! daemon_status "$name"; then
            echo "${DNAME}: ${name} 进程已退出，日志：${TRIM_PKGVAR}/log/${name}.log" >&2
            return 1
        fi
        if port_open "$port"; then
            echo "${DNAME}: ${name} 已监听端口 ${port}"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "${DNAME}: 等待 ${name} 监听端口 ${port} 超时" >&2
    return 1
}

do_start() {
    echo "${DNAME}: 正在启动 hbbs + hbbr ..."
    start_hbbs
    start_hbbr

    if ! wait_for_port "hbbs" 21116; then
        return 1
    fi
    if ! wait_for_port "hbbr" 21117; then
        return 1
    fi

    echo "${DNAME}: 服务已启动"
    echo "公钥文件：${DATA_DIR}/id_ed25519.pub（粘贴到 RustDesk Console 的 Web Client 设置）"
    return 0
}

do_stop() {
    echo "${DNAME}: 正在停止 hbbr + hbbs ..."
    stop_daemon "hbbr"
    stop_daemon "hbbs"
    echo "${DNAME}: 服务已停止"
}

do_status() {
    local running=true
    if daemon_status "hbbs"; then
        echo "${DNAME}: hbbs 运行中 (PID $(get_daemon_pid hbbs)，端口 21116)"
    else
        echo "${DNAME}: hbbs 未运行"
        running=false
    fi
    if daemon_status "hbbr"; then
        echo "${DNAME}: hbbr 运行中 (PID $(get_daemon_pid hbbr)，端口 21117)"
    else
        echo "${DNAME}: hbbr 未运行"
        running=false
    fi
    if $running; then
        return 0
    else
        return 3
    fi
}

do_log() {
    local log_dir="${TRIM_PKGVAR}/log"
    if [ -d "$log_dir" ]; then
        for f in "$log_dir"/*.log; do
            if [ -f "$f" ]; then
                echo "=== $(basename "$f") ==="
                tail -100 "$f"
                echo ""
            fi
        done
    else
        echo "${DNAME}: 暂无日志"
    fi
    echo "公钥文件：${DATA_DIR}/id_ed25519.pub"
}

case "${1}" in
    start) do_start ;;
    stop) do_stop ;;
    status) do_status ;;
    log) do_log ;;
    restart) do_stop; sleep 1; do_start ;;
    *) echo "用法: $0 {start|stop|restart|status|log}"; exit 1 ;;
esac
