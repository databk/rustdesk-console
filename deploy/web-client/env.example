# 把这些变量追加到现有部署目录的 .env，不要覆盖原文件。
# 建议填写验收说明中的两个固定摘要；不要换用 latest。
WEBCLIENT_BACKEND_IMAGE=ghcr.io/yardbirds0/rustdesk-console:web-client-v2-acceptance
WEBCLIENT_FRONTEND_IMAGE=ghcr.io/yardbirds0/rustdesk-console-web:web-client-v2-acceptance
WEB_CLIENT_ENABLED=true
WEB_CLIENT_ID_SERVER_URL=wss://rd.example.com/id
WEB_CLIENT_RELAY_SERVER_URL=wss://rd.example.com/relay
# id_ed25519.pub 的完整单行内容，不是私钥。
WEB_CLIENT_SERVER_PUBLIC_KEY=
