#!/bin/bash
# fnOS — main entry point (status / start / stop)
# Docker 应用实际由 fnOS AppCenter 通过 docker-compose 启停；
# 此脚本只负责状态检查。

COMPOSE="${TRIM_APPDEST}/docker/docker-compose.yaml"
CONTAINER_NAME="rustdesk-console"

is_running() {
  docker inspect "$CONTAINER_NAME" >/dev/null 2>&1 || return 1
  docker inspect "$CONTAINER_NAME" | grep -q '"Status": "running"'
}

case "$1" in
  start)
    # fnOS 会 docker-compose up 此 cmd 无需做事
    exit 0
    ;;
  stop)
    # fnOS 会 docker-compose down 此 cmd 无需做事
    exit 0
    ;;
  status)
    if is_running; then
      exit 0   # running
    fi
    exit 3     # not running
    ;;
  *)
    exit 1
    ;;
esac
