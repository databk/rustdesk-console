#!/bin/bash
# fnOS — Upgrade init hook
# Called before pulling the new image. Database migration happens in-container
# (DB_MIGRATE_ON_START=1); we just verify the old container can still read its data.
set -e

DATA_DIR="${TRIM_PKGVAR}/data"
if [ ! -d "$DATA_DIR" ]; then
  echo "[fnos] upgrade_init: warning — no pre-existing data dir at $DATA_DIR"
  mkdir -p "$DATA_DIR"
fi

# SQLite: WAL-shm-journal sidecars must live alongside the main file so the
# upgrade doesn't orphan them. fnOS bind-mounts ${TRIM_PKGVAR}/data → /data
# so the old and new containers see the same path. We lock nothing — fnOS
# stops the container before invoking this script.

echo "[fnos] upgrade_init: data dir verified"
