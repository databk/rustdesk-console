# RustDesk Console environment
# Copy to /opt/rustdesk-console/.env and customize

PORT=8000
NODE_ENV=production

# JWT secret (MUST change in production!)
JWT_SECRET=change-me-in-production

# Database — default SQLite in data dir
DATABASE_TYPE=sqlite
SQLITE_PATH=/var/lib/rustdesk-console/rustdesk-console.db

# Data directory
DATA_DIR=/var/lib/rustdesk-console
