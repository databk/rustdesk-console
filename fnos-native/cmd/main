#!/bin/sh
# 主入口 — 处理 start/stop/status/log/restart
# 完全对齐 conversun 官方实现，简化为单一 Sea 后端
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "${SCRIPT_DIR}/common"

# 安装期间由 fnOS 提供的临时日志文件
if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    exec >>"$TRIM_TEMP_LOGFILE" 2>&1
fi

. "${SCRIPT_DIR}/service-setup"

# 健康检查：Sea 后端 ready=true
http_ready() {
    local url="$1"
    local response
    if command -v curl >/dev/null 2>&1; then
        response=$(curl -fsS --connect-timeout 1 --max-time 2 "$url" 2>/dev/null) || return 1
    else
        response=$(wget -q -T 2 -O - "$url" 2>/dev/null) || return 1
    fi
    printf '%s' "$response" | grep -Eq '"ready"[[:space:]]*:[[:space:]]*true'
}

wait_for_ready() {
    local name="$1"
    local url="$2"
    local attempts=120
    local i=0
    while [ "$i" -lt "$attempts" ]; do
        if ! daemon_status "$name"; then
            echo "${DNAME}: ${name} 进程已退出，详见 ${TRIM_PKGVAR}/log/${name}.log" >&2
            return 1
        fi
        if http_ready "$url"; then
            echo "${DNAME}: ${name} 已就绪"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "${DNAME}: 等待 ${name} 就绪超时，详见 ${TRIM_PKGVAR}/log/${name}.log" >&2
    return 1
}

# ── 启动 ──
do_start() {
    echo "${DNAME}: 正在启动服务..."

    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        echo "${DNAME}: 启动健康检查需要 curl 或 wget" >&2
        return 1
    fi

    if ! start_backend; then
        return 1
    fi

    echo "${DNAME}: 等待 Sea 后端就绪..."
    if ! wait_for_ready "backend" "http://127.0.0.1:${SERVICE_PORT}/api/system-update/health"; then
        stop_daemon "backend"
        return 1
    fi

    echo "${DNAME}: 服务已启动"
    return 0
}

# ── 停止 ──
do_stop() {
    echo "${DNAME}: 正在停止服务..."
    stop_daemon "backend"
    echo "${DNAME}: 服务已停止"
}

# ── 状态 ──
do_status() {
    if daemon_status "backend"; then
        local bpid
        bpid=$(get_daemon_pid "backend")
        echo "${DNAME}: Sea 后端运行中 (PID ${bpid}，端口 ${SERVICE_PORT})"
        return 0
    else
        echo "${DNAME}: Sea 后端未运行"
        return 3
    fi
}

# ── 日志 ──
do_log() {
    local log_dir="${TRIM_PKGVAR}/log"
    if [ -d "$log_dir" ]; then
        for f in "$log_dir"/*.log; do
            [ -f "$f" ] && echo "=== $(basename "$f") ===" && tail -100 "$f" && echo ""
        done
    fi
    echo "凭据文件: ${TRIM_PKGVAR}/credentials"
}

# ── 主入口 ──
case "${1}" in
    start)   do_start ;;
    stop)    do_stop ;;
    status)  do_status ;;
    log)     do_log ;;
    restart) do_stop; sleep 1; do_start ;;
    *)       echo "用法: $0 {start|stop|restart|status|log}"; exit 1 ;;
esac
