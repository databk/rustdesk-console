#!/bin/sh
# 主入口 — 处理 start/stop/status/log/restart
# 集成版：Sea 后端（NestJS + 前端静态文件）+ hbbs + hbbr
# 完全对齐官方 v1.11.22 的 PID/日志/健康检查架构

set -e

# 加载公共函数
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "${SCRIPT_DIR}/common"

# 安装期间由 fnOS 提供的临时日志文件
if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    exec >>"$TRIM_TEMP_LOGFILE" 2>&1
fi

# 加载应用特定的服务配置
. "${SCRIPT_DIR}/service-setup"

# 健康检查：Sea 后端 ready=true
http_ready() {
    local url="$1"
    local response
    if command -v curl >/dev/null 2>&1; then
        response=$(curl -fsS --connect-timeout 1 --max-time 2 "$url" 2>/dev/null) || return 1
    else
        response=$(wget -q -T 2 -O - "$url" 2>/dev/null) || return 1
    fi
    printf '%s' "$response" | grep -Eq '"ready"[[:space:]]*:[[:space:]]*true'
}

wait_for_ready() {
    local name="$1"
    local url="$2"
    local attempts=120
    local i=0
    while [ "$i" -lt "$attempts" ]; do
        if ! daemon_status "$name"; then
            echo "${DNAME}: ${name} 进程已退出，详见 ${TRIM_PKGVAR}/log/${name}.log" >&2
            return 1
        fi
        if http_ready "$url"; then
            echo "${DNAME}: ${name} 已就绪"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "${DNAME}: 等待 ${name} 就绪超时，详见 ${TRIM_PKGVAR}/log/${name}.log" >&2
    return 1
}

# TCP 端口是否已监听（用于 hbbs/hbbr 健康检查）
port_open() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -tln 2>/dev/null | awk '{print $4}' | grep -q ":${port}$"
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tln 2>/dev/null | awk '{print $4}' | grep -q ":${port}$"
    else
        return 0
    fi
}

# 等待进程监听指定端口
wait_for_port() {
    local name="$1"
    local port="$2"
    local attempts=30
    local i=0
    while [ "$i" -lt "$attempts" ]; do
        if ! daemon_status "$name"; then
            echo "${DNAME}: ${name} 进程已退出，日志：${TRIM_PKGVAR}/log/${name}.log" >&2
            return 1
        fi
        if port_open "$port"; then
            echo "${DNAME}: ${name} 已监听端口 ${port}"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "${DNAME}: 等待 ${name} 监听端口 ${port} 超时" >&2
    return 1
}

# ── 启动服务 ──
do_start() {
    echo "${DNAME}: 正在启动服务..."

    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        echo "${DNAME}: 启动健康检查需要 curl 或 wget" >&2
        return 1
    fi

    if ! start_backend; then
        return 1
    fi

    echo "${DNAME}: 等待 Sea 后端就绪..."
    if ! wait_for_ready "backend" "http://127.0.0.1:${SERVICE_PORT}/api/system-update/health"; then
        stop_daemon "backend"
        return 1
    fi

    # 启动 hbbs + hbbr（OSS 版，无管理 API，Console 手动粘贴公钥）
    if [ -x "$HBBS_BIN" ] && [ -x "$HBBR_BIN" ]; then
        echo "${DNAME}: 启动 hbbs + hbbr ..."
        start_hbbs
        start_hbbr

        if ! wait_for_port "hbbs" 21116; then
            stop_daemon "hbbr"
            stop_daemon "hbbs"
            stop_daemon "backend"
            return 1
        fi
        if ! wait_for_port "hbbr" 21117; then
            stop_daemon "hbbr"
            stop_daemon "hbbs"
            stop_daemon "backend"
            return 1
        fi
        echo "${DNAME}: hbbs/hbbr 公钥：${DATA_DIR}/id_ed25519.pub（粘贴到 Console 的 Web Client 设置）"
    else
        echo "${DNAME}: 未找到 hbbs/hbbr 二进制，跳过自建服务器启动"
    fi

    echo "${DNAME}: 服务已启动"
    return 0
}

# ── 停止服务 ──
do_stop() {
    echo "${DNAME}: 正在停止服务..."
    stop_daemon "hbbr"
    stop_daemon "hbbs"
    stop_daemon "backend"
    echo "${DNAME}: 服务已停止"
}

# ── 检查服务状态 ──
do_status() {
    local running=true

    if daemon_status "backend"; then
        local bpid
        bpid=$(get_daemon_pid "backend")
        echo "${DNAME}: Sea 后端运行中 (PID ${bpid}，端口 ${SERVICE_PORT})"
    else
        echo "${DNAME}: Sea 后端未运行"
        running=false
    fi

    if daemon_status "hbbs"; then
        echo "${DNAME}: hbbs 运行中 (PID $(get_daemon_pid hbbs)，端口 21116)"
    else
        echo "${DNAME}: hbbs 未运行"
        running=false
    fi

    if daemon_status "hbbr"; then
        echo "${DNAME}: hbbr 运行中 (PID $(get_daemon_pid hbbr)，端口 21117)"
    else
        echo "${DNAME}: hbbr 未运行"
        running=false
    fi

    if $running; then
        return 0
    else
        return 3
    fi
}

# ── 输出日志 ──
do_log() {
    local log_dir="${TRIM_PKGVAR}/log"
    if [ -d "$log_dir" ]; then
        for f in "$log_dir"/*.log; do
            if [ -f "$f" ]; then
                echo "=== $(basename "$f") ==="
                tail -100 "$f"
                echo ""
            fi
        done
    fi
    echo "凭据文件: ${TRIM_PKGVAR}/credentials"
}

# ── 主入口 ──
case "${1}" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    status)
        do_status
        ;;
    log)
        do_log
        ;;
    restart)
        do_stop
        sleep 1
        do_start
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status|log}"
        exit 1
        ;;
esac
