#!/bin/bash
# fnOS Native — main entry point
# 管理原生 Sea 二进制的 start / stop / status
# Sea 二进制不支持 --port/--data-dir 等 CLI flag，统一用环境变量传入
#
# 日志策略：所有动作都写 ${LOG_FILE}；任何失败前先把最近 50 行 Sea 日志打一份到 LOG_FILE，
# 让用户在 fnOS UI 的"日志 / 失败原因"里直接看到真实错误，而不是"执行脚本出错原因未知"。

APP_BIN_DIR="${TRIM_APPDEST}/bin"
APP_PUBLIC_DIR="${TRIM_APPDEST}/public"
DATA_DIR="${TRIM_PKGVAR:-/var/apps-data/rustdesk-console}/data"

# LOG_FILE 3 层 fallback：TRIM_PKGVAR → TRIM_APPDEST → /tmp
# 之前 TRIM_PKGVAR 为空时直接拼成 /info.log（根目录不可写）→ 所有日志静默丢失
if [ -n "${TRIM_PKGVAR}" ] && [ -d "${TRIM_PKGVAR}" ]; then
    LOG_FILE="${TRIM_PKGVAR}/info.log"
elif [ -n "${TRIM_APPDEST}" ]; then
    LOG_FILE="${TRIM_APPDEST}/info.log"
else
    LOG_FILE="/tmp/rustdesk-console.log"
fi
mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || LOG_FILE="/tmp/rustdesk-console.log"

PID_FILE="${TRIM_PKGVAR:-/tmp}/app.pid"

export PORT="${PORT:-3000}"
export NODE_ENV=production
export DATA_DIR="${DATA_DIR}"

# 启动第一行立刻 dump 环境变量 — 确保哪怕后续崩了，日志里也有根因线索
echo "=== cmd/main 启动: TRIM_PKGVAR=${TRIM_PKGVAR:-<empty>} TRIM_APPDEST=${TRIM_APPDEST:-<empty>} LOG_FILE=${LOG_FILE} arch=$(uname -m) ===" >> "${LOG_FILE}"

# ── 公共诊断 helper ────────────────────────────────────────────────

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 把 Sea 进程的 stdout/stderr（都已经 redirect 到 LOG_FILE 里）最近一段抄出来当失败现场
dump_sea_tail() {
  local label="$1"
  log_msg "────────────────────────────────────────────────────────────────"
  log_msg "LAST SEA LOGS BEFORE ${label}:"
  tail -60 "${LOG_FILE}" | sed 's/^/  │ /' >> "${LOG_FILE}"
  log_msg "────────────────────────────────────────────────────────────────"
}

on_fatal() {
  # 所有致命错误走到这里：打印现场 → 明确 exit 1
  dump_sea_tail "FATAL"
  log_msg "FATAL: cmd/main failed at $1"
  exit 1
}

trap 'on_fatal "start_process"' ERR 2>/dev/null || true

# ── 按架构选二进制 ─────────────────────────────────────────────────

pick_binary() {
  local arch
  arch=$(uname -m)
  case "$arch" in
    x86_64|amd64)   echo "${APP_BIN_DIR}/rustdesk-console-x64" ;;
    aarch64|arm64)  echo "${APP_BIN_DIR}/rustdesk-console-arm64" ;;
    *)
      for bin in "${APP_BIN_DIR}/rustdesk-console-"*; do
        [ -x "$bin" ] && { echo "$bin"; return; }
      done
      echo ""
      ;;
  esac
}

# ── 进程状态 ──────────────────────────────────────────────────────

check_process() {
  local pid=$1
  kill -0 "${pid}" 2>/dev/null
}

status() {
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid=$(tr -d '[:space:]' < "${PID_FILE}")
    if check_process "${pid}"; then
      return 0
    fi
    rm -f "${PID_FILE}"
  fi
  return 1
}

# ── 主流程：migrate → start ─────────────────────────────────────────

run_migrations() {
  local bin="$1"
  log_msg "[migrate] running database migrations..."
  local migrate_out
  migrate_out=$(cd "${APP_BIN_DIR}" && exec "${bin}" migrate 2>&1)
  local rc=$?
  if [ $rc -ne 0 ]; then
    log_msg "FATAL: migrate command failed (exit=$rc)"
    echo "${migrate_out}" | sed 's/^/  │ /' >> "${LOG_FILE}"
    return $rc
  fi
  log_msg "[migrate] done"
  return 0
}

start_process() {
  mkdir -p "${DATA_DIR}"

  # 1. 选二进制
  local bin
  bin=$(pick_binary)
  if [ -z "${bin}" ] || [ ! -x "${bin}" ]; then
    log_msg "FATAL: no usable rustdesk-console binary for arch $(uname -m)"
    log_msg "  expected one of:"
    ls -la "${APP_BIN_DIR}"/rustdesk-console-* 2>/dev/null | sed 's/^/  │ /' >> "${LOG_FILE}" || true
    return 1
  fi
  log_msg "Using binary: ${bin}"

  # 2. 数据库迁移（最容易失败的一步，单独包住）
  if ! run_migrations "${bin}"; then
    return 1
  fi

  # 3. 启动
  log_msg "Starting → :${PORT} (DATA_DIR=${DATA_DIR})"
  (
    cd "${APP_BIN_DIR}"
    exec "${bin}" >> "${LOG_FILE}" 2>&1
  ) &

  echo $! > "${PID_FILE}"
  sleep 1

  if ! check_process "$(cat "${PID_FILE}")"; then
    log_msg "FATAL: Sea process died immediately after start"
    log_msg "  possible causes (check tail below):"
    log_msg "    - pending migrations (we just ran migrate, should not happen)"
    log_msg "    - glibc / dynamic linker mismatch (try on different fnOS device)"
    log_msg "    - missing node_modules / native addons (should be in ${APP_BIN_DIR}/node_modules/)"
    log_msg "    - DATA_DIR permission / disk full / sqlite path"
    dump_sea_tail "start-immediate-crash"
    rm -f "${PID_FILE}"
    return 1
  fi

  log_msg "Started PID=$(cat "${PID_FILE}")"
  return 0
}

stop_process() {
  if ! status; then
    return 0
  fi

  local pid
  pid=$(tr -d '[:space:]' < "${PID_FILE}")
  log_msg "Stopping PID=${pid} (TERM → wait 10s → KILL)"

  kill -TERM "${pid}" 2>/dev/null
  local count=0
  while check_process "${pid}" && [ ${count} -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done

  if check_process "${pid}"; then
    kill -KILL "${pid}" 2>/dev/null
    sleep 1
  fi
  rm -f "${PID_FILE}"
  log_msg "Stopped"
}

case "$1" in
  start)  start_process   ;;
  stop)   stop_process    ;;
  status)
    if status; then exit 0; else exit 3; fi
    ;;
  *)
    exit 1
    ;;
esac
