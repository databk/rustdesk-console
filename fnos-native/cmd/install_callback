#!/bin/bash
# fnOS Native — install_callback
# Wait for Sea binary to become reachable on PORT=3000.
# 多层 fallback，不假设 fnOS 上有 curl/wget。
set -e

INTERNAL_PORT="${INTERNAL_PORT:-3000}"
PID_FILE="${TRIM_PKGVAR}/app.pid"
MAX=60

http_probe() {
  local url="$1" host port path
  host=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\1|p')
  port=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\2|p')
  path=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\3|p')

  if command -v curl >/dev/null 2>&1; then
    curl -sf -o /dev/null --max-time 2 "$url" && return 0
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -qO /dev/null --timeout=2 "$url" && return 0
  fi
  if [ -B /dev/tcp ] && exec 3<>"/dev/tcp/${host}/${port}" 2>/dev/null; then
    printf 'GET %s HTTP/1.0\r\nHost: %s\r\n\r\n' "$path" "$host" >&3
    grep -qE 'HTTP/1\.[01] 2[0-9][0-9]' <&3 && { exec 3>&-; return 0; }
    exec 3>&-
  fi
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | grep -q ":${port}[[:space:]]" && return 0
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltn 2>/dev/null | grep -q ":${port}[[:space:]]" && return 0
  fi
  return 1
}

# 先检查进程是否还活着（进程挂了就不用等了）
if [ -f "$PID_FILE" ]; then
  PID=$(tr -d '[:space:]' < "$PID_FILE")
  if ! kill -0 "$PID" 2>/dev/null; then
    echo "[fnos-native] install_callback: Sea process (PID=$PID) died immediately — check ${TRIM_PKGVAR}/info.log" >&2
    exit 1
  fi
fi

for i in $(seq 1 $MAX); do
  if http_probe "http://localhost:${INTERNAL_PORT}/api/login-options"; then
    echo "[fnos-native] install_callback: console healthy on :${INTERNAL_PORT}"
    exit 0
  fi
  sleep 2
done

echo "[fnos-native] install_callback: health timeout on :${INTERNAL_PORT} — check ${TRIM_PKGVAR}/info.log" >&2
exit 1
