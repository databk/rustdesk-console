#!/bin/bash
# fnOS Native — install_callback
# 等 Sea 变成可访问（最多 120s）。失败时把现场完整写到 info.log。
set -e

INTERNAL_PORT="${INTERNAL_PORT:-3000}"
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/info.log"
MAX=60

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - [install_callback] $1" >> "${LOG_FILE}"
}

dump_sea_tail() {
  log_msg "───────────────────────────────────────────────"
  log_msg "SEA LOG TAIL:"
  tail -40 "${LOG_FILE}" | sed 's/^/  │ /' >> "${LOG_FILE}"
  log_msg "───────────────────────────────────────────────"
}

on_error() {
  log_msg "FATAL: install_callback shell error at line $1 (exit=$?)"
  exit 1
}
trap 'on_error $LINENO' ERR

http_probe() {
  local url="$1" host port path
  host=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\1|p')
  port=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\2|p')
  path=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\3|p')

  command -v curl >/dev/null 2>&1 && curl -sf -o /dev/null --max-time 2 "$url" && return 0
  command -v wget >/dev/null 2>&1 && wget -qO /dev/null --timeout=2 "$url" && return 0
  if [ -B /dev/tcp ] && exec 3<>"/dev/tcp/${host}/${port}" 2>/dev/null; then
    printf 'GET %s HTTP/1.0\r\nHost: %s\r\n\r\n' "$path" "$host" >&3
    grep -qE 'HTTP/1\.[01] 2[0-9][0-9]' <&3 && { exec 3>&-; return 0; }
    exec 3>&-
  fi
  command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ":${port}[[:space:]]" && return 0
  command -v netstat >/dev/null 2>&1 && netstat -ltn 2>/dev/null | grep -q ":${port}[[:space:]]" && return 0
  return 1
}

log_msg "Waiting for Sea on :${INTERNAL_PORT}..."

# ── 第一轮：检查 PID + 端口 ──
if [ -f "$PID_FILE" ]; then
  PID=$(tr -d '[:space:]' < "$PID_FILE")
  if ! kill -0 "$PID" 2>/dev/null; then
    log_msg "FATAL: Sea process PID=$PID died immediately"
    dump_sea_tail
    exit 1
  fi
  log_msg "Sea PID=$PID alive, port ${INTERNAL_PORT} listening? $( command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ":${INTERNAL_PORT}[[:space:]]" && echo yes || echo no )"
fi

# ── 第二轮：HTTP 探活 ──
for i in $(seq 1 $MAX); do
  if http_probe "http://localhost:${INTERNAL_PORT}/api/login-options"; then
    log_msg "OK: console healthy on :${INTERNAL_PORT} (after $((i*2))s)"
    exit 0
  fi
  sleep 2
done

# ── 超时：把现场全写进 info.log ──
log_msg "FATAL: health timeout on :${INTERNAL_PORT} (waited $((MAX*2))s)"
log_msg "  PID file : $( [ -f "$PID_FILE" ] && cat "$PID_FILE" || echo '(not present)' )"
log_msg "  PID alive? $( [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null && echo yes || echo no )"
log_msg "  port ${INTERNAL_PORT} listeners:"
command -v ss >/dev/null 2>&1 && ss -ltnp 2>/dev/null | grep ":${INTERNAL_PORT}" | sed 's/^/    /' >> "${LOG_FILE}" || \
  (command -v netstat >/dev/null 2>&1 && netstat -ltnp 2>/dev/null | grep ":${INTERNAL_PORT}" | sed 's/^/    /' >> "${LOG_FILE}")
dump_sea_tail
exit 1
