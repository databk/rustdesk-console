#!/bin/bash
# fnOS Native — install_callback (v1.11.17)
# 关键点：完全不依赖 fnOS 注入的 TRIM_* 环境变量
# 因为不同 fnOS 版本 / 不同回调阶段 TRIM_* 可能为空
# 所有诊断信息同时写 stderr（fnOS 必展示）和 /tmp/rustdesk-console.log

set -e

INTERNAL_PORT="${INTERNAL_PORT:-3000}"
MAX=60

# ── 硬编码 fallback 日志文件 ──
# fnOS 框架在外部会 tail @appdata/rustdesk-console/info.log
# 但 TRIM_PKGVAR 可能为空，导致我们写不到那个位置
# 所以同时写 stderr 和 /tmp 路径，确保至少有一个能看到
LOG_STDERR=1
LOG_TMP="/tmp/rustdesk-console.log"

log_msg() {
  local line="$(date '+%Y-%m-%d %H:%M:%S') - [install_callback] $1"
  echo "${line}" >> "${LOG_TMP}"
  # 同时写 stderr — fnOS 必展示
  echo "  ${line}" 1>&2
}

# ── 第一优先级：立刻 dump 所有环境变量到 stderr ──
# 让我们在 fnOS UI 里直接看到 TRIM_APPDEST / TRIM_PKGVAR 到底是什么
{
  echo "========== install_callback 环境变量 dump =========="
  echo "  TRIM_PKGVAR=${TRIM_PKGVAR:-<EMPTY>}"
  echo "  TRIM_APPDEST=${TRIM_APPDEST:-<EMPTY>}"
  echo "  TRIM_TEMP_LOGFILE=${TRIM_TEMP_LOGFILE:-<EMPTY>}"
  echo "  arch=$(uname -m)"
  echo "  PWD=$(pwd)"
  echo "====================================================="
} 1>&2

# ── 探测实际文件位置（不依赖 TRIM_*） ──
log_msg "探测 Sea 二进制位置..."

# fnOS 安装后的常见路径
CANDIDATE_BINS=(
  "${TRIM_APPDEST}/bin/rustdesk-console-x64"
  "${TRIM_APPDEST}/app/bin/rustdesk-console-x64"
  "${TRIM_APPDEST:-/var/apps/rustdesk-console}/bin/rustdesk-console-x64"
  "${TRIM_APPDEST:-/var/apps/rustdesk-console}/app/bin/rustdesk-console-x64"
  "/var/apps/rustdesk-console/bin/rustdesk-console-x64"
  "/vol1/@appdata/rustdesk-console/bin/rustdesk-console-x64"
  "/vol1/appcenter-downloads/rustdesk-console-*/bin/rustdesk-console-x64"
)

SEA_BIN=""
for cand in "${CANDIDATE_BINS[@]}"; do
  # 处理通配符
  for b in ${cand}; do
    if [ -f "${b}" ]; then
      SEA_BIN="${b}"
      log_msg "找到 Sea: ${SEA_BIN}"
      break 2
    fi
  done
done

if [ -z "${SEA_BIN}" ]; then
  # find 兜底
  SEA_BIN=$(find /var/apps /vol1 -name "rustdesk-console-x64" -type f 2>/dev/null | head -1)
  if [ -n "${SEA_BIN}" ]; then
    log_msg "find 兜底找到: ${SEA_BIN}"
  fi
fi

# 同样探测 cmd/main
MAIN=""
if [ -n "${TRIM_APPDEST}" ] && [ -x "${TRIM_APPDEST}/cmd/main" ]; then
  MAIN="${TRIM_APPDEST}/cmd/main"
else
  MAIN=$(find /var/apps /vol1 -path "*/cmd/main" -executable 2>/dev/null | head -1)
fi

log_msg "MAIN=${MAIN:-<未找到>}"

fail() {
  local msg="$1"
  log_msg "FATAL: $msg"
  {
    echo ""
    echo "========================================"
    echo "RustDesk Console Native 安装失败"
    echo "========================================"
    echo "原因: $msg"
    echo ""
    echo "现场 (tail 30 from ${LOG_TMP}):"
    tail -30 "${LOG_TMP}" 2>/dev/null || echo "(${LOG_TMP} 不存在)"
    echo ""
    echo "=== 系统状态 ==="
    echo "  Sea 二进制: ${SEA_BIN:-<未找到>}"
    echo "  cmd/main: ${MAIN:-<未找到>}"
    echo "  进程: $(ps aux | grep rustdesk-console | grep -v grep || echo '无')"
    echo "  端口: $(ss -tlnp 2>/dev/null | grep 3000 || echo '3000 未监听')"
  } 1>&2
  exit 1
}

http_probe() {
  local url="$1" host port path
  host=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\1|p')
  port=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\2|p')
  path=$(echo "$url" | sed -n 's|http://\([^:]*\):\([0-9]*\)\(.*\)|\3|p')
  command -v curl >/dev/null 2>&1 && curl -sf -o /dev/null --max-time 2 "$url" && return 0
  command -v wget >/dev/null 2>&1 && wget -qO /dev/null --timeout=2 "$url" && return 0
  # bash /dev/tcp 探测（不带 [ -B ... ]，那不是 test 合法参数）
  if exec 3<>"/dev/tcp/${host}/${port}" 2>/dev/null; then
    printf 'GET %s HTTP/1.0\r\nHost: %s\r\n\r\n' "$path" "$host" >&3
    grep -qE 'HTTP/1\.[01] 2[0-9][0-9]' <&3 && { exec 3>&-; return 0; }
    exec 3>&-
  fi
  return 1
}

log_msg "=== install_callback 启动 ==="
log_msg "Waiting for Sea on :${INTERNAL_PORT}..."

# ── 补权限 ──
if [ -n "${SEA_BIN}" ]; then
  chmod +x "${SEA_BIN}" 2>/dev/null || true
  # 目录里所有二进制
  chmod +x "$(dirname "${SEA_BIN}")"/rustdesk-console-* 2>/dev/null || true
fi

# ── 先 pidof 检查：Sea 是不是已经在跑 ──
if pidof rustdesk-console >/dev/null 2>&1 || pidof rustdesk-console-x64 >/dev/null 2>&1; then
  log_msg "Sea already running (pidof matched), skip cmd/main start"
else
  log_msg "Sea 未运行，调 cmd/main start ..."

  if [ -n "${MAIN}" ] && [ -x "${MAIN}" ]; then
    "${MAIN}" start >> "${LOG_TMP}" 2>&1
    rc=$?
    log_msg "cmd/main start exited with rc=${rc}"

    if [ $rc -ne 0 ]; then
      fail "cmd/main start failed (rc=${rc}) — 看 ${LOG_TMP} 里的 cmd/main 输出"
    fi
  elif [ -n "${SEA_BIN}" ]; then
    # cmd/main 找不到 → 绕过，手动启动 Sea
    log_msg "cmd/main 不可用，手动启动 Sea..."

    BIN_DIR="$(dirname "${SEA_BIN}")"
    DATA_DIR="${TRIM_PKGVAR:-/var/apps-data/rustdesk-console}/data"
    mkdir -p "${DATA_DIR}" 2>/dev/null || DATA_DIR="/tmp/rustdesk-data"

    (
      cd "${BIN_DIR}"
      PORT=3000 DATA_DIR="${DATA_DIR}" exec "${SEA_BIN}" >> "${LOG_TMP}" 2>&1
    ) &
    echo $! > /tmp/rustdesk-console.pid
    sleep 2

    if ! kill -0 "$(cat /tmp/rustdesk-console.pid)" 2>/dev/null; then
      log_msg "FATAL: Sea 手动启动后立刻崩了"
      fail "Sea binary exists but crashed immediately. Check ${LOG_TMP}"
    fi

    log_msg "手动启动成功 PID=$(cat /tmp/rustdesk-console.pid)"
  else
    fail "Sea 二进制和 cmd/main 都找不到 — FPK 可能解压不完整"
  fi
fi

# ── 健康检查循环 ──
for i in $(seq 1 $MAX); do
  if http_probe "http://localhost:${INTERNAL_PORT}/api/login-options"; then
    log_msg "OK: healthy on :${INTERNAL_PORT} (after $((i*2))s)"
    exit 0
  fi
  sleep 2
done

fail "health timeout on :${INTERNAL_PORT} (waited $((MAX*2))s)"
