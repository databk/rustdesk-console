#!/bin/sh
# 配置回调 - 保存系统设置并在服务运行时重启
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
DNAME="RustDesk Console"
LOG_LEVEL="${wizard_log_level:-log}"
RELAY_ADDRESS="${wizard_relay_address:-}"

case "$LOG_LEVEL" in
    verbose|debug|log|warn|error|fatal) ;;
    *)
        echo "${DNAME}: 不支持的日志级别: ${LOG_LEVEL}" >&2
        exit 1
        ;;
esac

mkdir -p "${TRIM_PKGETC}"
printf 'LOG_LEVEL=%s\n' "$LOG_LEVEL" > "${TRIM_PKGETC}/settings.conf"
printf 'RELAY_ADDRESS=%s\n' "$RELAY_ADDRESS" >> "${TRIM_PKGETC}/settings.conf"
chmod 644 "${TRIM_PKGETC}/settings.conf"

if "${SCRIPT_DIR}/main" status >/dev/null 2>&1; then
    echo "${DNAME}: 配置已保存，重启服务..."
    "${SCRIPT_DIR}/main" restart
else
    echo "${DNAME}: 配置已保存"
fi
