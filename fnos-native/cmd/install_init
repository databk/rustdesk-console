#!/bin/bash
# fnOS Native — install_init
# 在 fnOS 解压文件之前执行。只能操作 TRIM_PKGVAR（var/ 数据目录，系统提前建好）。
# ⚠️ 错误输出到 stderr（fnOS 框架会直接展示给用户）。
set -e

LOG_FILE="${TRIM_PKGVAR:-/tmp}/info.log"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - [install_init] $1" >> "${LOG_FILE}"
}

fail() {
  local msg="$1"
  log_msg "FATAL: $msg"
  echo "install_init: $msg" 1>&2
  exit 1
}

log_msg "arch=$(uname -m) TRIM_PKGVAR=${TRIM_PKGVAR:-empty} TRIM_APPDEST=${TRIM_APPDEST:-empty}"

# ── 数据目录（系统应已建好 var/，这里只确保子目录）──
DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "${DATA_DIR}" || fail "cannot mkdir ${DATA_DIR}"
chmod 755 "${DATA_DIR}"
log_msg "DATA_DIR ready: ${DATA_DIR}"

log_msg "install_init done"
