# fnOS Dockerfile — 组装 console 后端 + 前端静态资源成单镜像
# 前端静态资源在构建时由 workflow 放在 fnos/app/docker/web-dist/

FROM node:24-alpine AS backend-builder
WORKDIR /app
COPY package*.json ./
COPY tsconfig*.json ./
COPY nest-cli.json ./
COPY src ./src
RUN npm ci --ignore-scripts && npm run build

# Production image
FROM node:24-alpine
WORKDIR /app

# 后端运行依赖
COPY --from=backend-builder /app/package*.json ./
COPY --from=backend-builder /app/dist ./dist
RUN npm ci --omit=dev --ignore-scripts && rm -rf /tmp/*

# 前端静态资源（由 GitHub Actions 放到 fnos/app/docker/web-dist/）
COPY web-dist ./public

EXPOSE 3000
ENV NODE_ENV=production PORT=3000 DATA_DIR=/data

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/login-options', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

CMD ["sh", "-c", "if [ \"${DB_MIGRATE_ON_START:-1}\" = 1 ]; then node dist/main.js migrate || exit $?; fi; exec node dist/main.js"]
