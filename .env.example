# Server Configuration
# PORT=3000

# JWT Configuration
# JWT_SECRET=rustdesk-api-secret-key-change-in-production

# Data Directory (unified storage for database and build artifacts)
# Both the SQLite database and Nexus build artifacts are stored here.
# Only used when DB_TYPE=sqlite.
# DATA_DIR=./data

# Database Type (sqlite | mysql, default: sqlite)
# DB_TYPE=sqlite

# MySQL Configuration (only used when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=rustdesk_console

# 自维护浏览器客户端（默认关闭）
WEB_CLIENT_ENABLED=false
# 由管理员控制的 HTTPS/WSS 部署地址；不得包含凭据、查询参数或片段。
# WEB_CLIENT_ID_SERVER_URL=wss://remote.example.com/id
# WEB_CLIENT_RELAY_SERVER_URL=wss://remote.example.com/relay
# 公开 id_ed25519.pub 密钥：32 字节的规范 Base64 编码，禁止填写私钥。
# WEB_CLIENT_SERVER_PUBLIC_KEY=
