# Server Configuration
# PORT=3000

# JWT Configuration
# JWT_SECRET=rustdesk-api-secret-key-change-in-production

# Data Directory (unified storage for database and build artifacts)
# Both the SQLite database and Nexus build artifacts are stored here.
# MySQL deployments also use this directory for business files.
# DATA_DIR=./data

# Database Type (sqlite | mysql, default: sqlite)
# DB_TYPE=sqlite

# MySQL Configuration (only used when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=rustdesk_console

# Optional RustDesk server profile (hbbs/hbbr). Set COMPOSE_PROFILES=server to
# deploy the RustDesk server alongside the Console, then fill in
# RUSTDESK_RELAY_ADDRESS and SERVER_MANAGEMENT_TOKEN, and point
# HBBS_MANAGEMENT_URL at hbbs to enable server management in the backend.
# COMPOSE_PROFILES=server
# RUSTDESK_RELAY_ADDRESS=relay.example.com:21117

# Server management talks to one hbbs upstream (origin only; token minimum 32 characters).
# HBBS_MANAGEMENT_URL=http://hbbs:21120
# SERVER_MANAGEMENT_TOKEN=replace-with-a-random-token-at-least-32-characters
# SERVER_MANAGEMENT_NODE_ID=main

# Docker only: set to 0 when a separate single migration job runs before all replicas.
# DB_MIGRATE_ON_START=1
# Required by the standard Compose installation (generate unique values).
# JWT_SECRET=
# ADMIN_PASSWORD=
# CONSOLE_INSTALL_DIR=/opt/rustdesk-console-compose
# MySQL automatic recovery requires a schema dedicated to this application.
# SYSTEM_UPDATE_MYSQL_EXCLUSIVE_SCHEMA=true

# These paths are provisioned by the standard installer / Compose deployment.
# Do not expose the updater socket through TCP or mount private state in the API.
# SYSTEM_UPDATE_INSTALLATION=/etc/rustdesk-console/installation.json
# SYSTEM_UPDATE_SOCKET=/run/rustdesk-console-updater/control.sock
# SYSTEM_UPDATE_MAINTENANCE_FILE=/var/lib/rustdesk-console-maintenance/maintenance.json
# SYSTEM_UPDATE_COMPOSE_ROOT=/opt/rustdesk-console-compose
# SYSTEM_UPDATE_SOCKET_GID=1000
# SOURCE_COMMIT is injected by the official build; do not override in production.

# 网页远控默认关闭。启用后，普通用户必须具有 web_client.connect 角色权限。
# WEB_CLIENT_ENABLED=false
# WEB_CLIENT_ALLOWED_ORIGIN=https://console.example.com
# WEB_CLIENT_ID_SERVER_URL=wss://console.example.com/ws/id
# WEB_CLIENT_RELAY_SERVER_URL=wss://console.example.com/ws/relay
# WEB_CLIENT_SERVER_PUBLIC_KEY=
# 仅后端使用的固定上游，可走容器网络；省略时使用上面的公开 WSS 地址。
# WEB_CLIENT_ID_UPSTREAM_URL=ws://rustdesk-hbbs:21118
# WEB_CLIENT_RELAY_UPSTREAM_URL=ws://rustdesk-hbbr:21119
