# Server Configuration
# PORT=3000

# JWT Configuration
# JWT_SECRET=rustdesk-api-secret-key-change-in-production

# Data Directory (unified storage for database and build artifacts)
# Both the SQLite database and Nexus build artifacts are stored here.
# MySQL deployments also use this directory for business files.
# DATA_DIR=./data

# Database Type (sqlite | mysql, default: sqlite)
# DB_TYPE=sqlite

# MySQL Configuration (only used when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=rustdesk_console

# Required by the standard Compose installation (generate unique values).
# JWT_SECRET=
# ADMIN_PASSWORD=
# CONSOLE_INSTALL_DIR=/opt/rustdesk-console-compose
# MySQL automatic recovery requires a schema dedicated to this application.
# SYSTEM_UPDATE_MYSQL_EXCLUSIVE_SCHEMA=true

# These paths are provisioned by the standard installer / Compose deployment.
# Do not expose the updater socket through TCP or mount private state in the API.
# SYSTEM_UPDATE_INSTALLATION=/etc/rustdesk-console/installation.json
# SYSTEM_UPDATE_SOCKET=/run/rustdesk-console-updater/control.sock
# SYSTEM_UPDATE_MAINTENANCE_FILE=/var/lib/rustdesk-console-maintenance/maintenance.json
# SYSTEM_UPDATE_COMPOSE_ROOT=/opt/rustdesk-console-compose
# SYSTEM_UPDATE_SOCKET_GID=1000
# SOURCE_COMMIT is injected by the official build; do not override in production.
