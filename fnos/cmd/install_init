#!/bin/bash
# fnOS — install_init
set -e

LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - [fnos/install_init] $1" >> "${LOG_FILE}"
}

on_error() {
  log_msg "FATAL: fnOS install_init failed at line $1 (exit=$?)"
  exit 1
}
trap 'on_error $LINENO' ERR

DATA_DIR="${TRIM_PKGVAR}/data"
mkdir -p "$DATA_DIR"
chmod 755 "$DATA_DIR"
log_msg "DATA_DIR ready: $DATA_DIR"
log_msg "fnOS install_init done"
