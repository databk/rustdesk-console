[Unit]
Description=RustDesk Console backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rustdesk-console
Group=rustdesk-console
WorkingDirectory=/var/lib/rustdesk-console
EnvironmentFile=/etc/rustdesk-console/backend.env
ExecStart=/opt/rustdesk-console/current-backend/rustdesk-console
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rustdesk-console

[Install]
WantedBy=multi-user.target
