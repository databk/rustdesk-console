# Export a complete Linux bundle without installing build tools on the host.
ARG NODE_IMAGE=node:24-bookworm
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG SOURCE_COMMIT
ARG APP_VERSION
ENV SOURCE_COMMIT=${SOURCE_COMMIT} APP_VERSION=${APP_VERSION}
RUN npm run build:sea

FROM scratch AS bundle
COPY --from=build /app/dist-sea/ /
